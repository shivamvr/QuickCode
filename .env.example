# Copy this to .env and put your own key in it. .env is gitignored.
#
# This file is only read when you run the function locally with `netlify dev`.
# The DEPLOYED site does not read it - set GROQ_API_KEY in the host's
# environment variables instead (on Netlify: Site configuration ->
# Environment variables).
#
# A free key, no card needed: https://console.groq.com/keys

GROQ_API_KEY=
